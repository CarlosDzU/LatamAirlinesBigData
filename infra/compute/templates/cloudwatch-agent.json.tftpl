{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/latam-ops/*.log",
            "log_group_name": "${log_group_jobs}",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/opt/spark/logs/*.out",
            "log_group_name": "${log_group_spark}",
            "log_stream_name": "{instance_id}-spark",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/bootstrap.log",
            "log_group_name": "${log_group_spark}",
            "log_stream_name": "{instance_id}-bootstrap",
            "retention_in_days": -1
          }
        ]
      }
    }
  }
}
